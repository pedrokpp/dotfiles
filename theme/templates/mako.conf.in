# Generated from theme/catppuccin-mocha.json.
font=JetBrains Mono 11
background-color=#{{base}}ee
text-color=#{{text}}ff
border-color=#{{mauve}}ff
progress-color=over #{{surface0}}ff
width=360
height=120
margin=12
padding=14
border-size=2
border-radius=10
icons=1
max-icon-size=48
markup=1
actions=1
max-history=10
default-timeout=7000
ignore-timeout=0
layer=overlay
anchor=top-right

[urgency=low]
border-color=#{{surface1}}ff
default-timeout=4000

[urgency=critical]
border-color=#{{red}}ff
default-timeout=0
