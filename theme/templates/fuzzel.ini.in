# Generated from theme/catppuccin-mocha.json.
[main]
font=JetBrains Mono:size=12
terminal=kitty
launch-prefix=uwsm app --
layer=overlay
prompt=Run > 
placeholder=Type an application name
icon-theme=Adwaita
icons-enabled=yes
lines=10
width=52
horizontal-pad=20
vertical-pad=14
inner-pad=8
line-height=22
image-size-ratio=0.5
fields=name,generic,comment,categories,filename,keywords
match-mode=fzf
sort-result=yes
show-actions=yes
exit-on-keyboard-focus-loss=yes

[border]
width=2
radius=12

[dmenu]
exit-immediately-if-empty=no

[colors]
background={{base}}ee
text={{text}}ff
prompt={{mauve}}ff
placeholder={{overlay0}}ff
input={{text}}ff
match={{pink}}ff
selection={{surface0}}ff
selection-text={{text}}ff
selection-match={{pink}}ff
counter={{overlay2}}ff
border={{blue}}ff
